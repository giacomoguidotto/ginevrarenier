# Convex Backend
CONVEX_DEPLOYMENT= # filled on first `bunx convex dev`
NEXT_PUBLIC_CONVEX_URL= # filled on first `bunx convex dev`

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= # from https://dashboard.clerk.com
CLERK_SECRET_KEY= # from https://dashboard.clerk.com
CLERK_JWT_ISSUER_DOMAIN= # from Clerk JWT Templates
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME= # from https://console.cloudinary.com
CLOUDINARY_API_KEY= # from https://console.cloudinary.com
CLOUDINARY_API_SECRET= # from https://console.cloudinary.com
